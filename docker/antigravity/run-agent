#!/bin/sh
set -eu

prompt_file="${1:-/workspace/.benchmark_prompt.txt}"
prompt="$(cat "$prompt_file")"

if [ -n "${ANTIGRAVITY_RUN_COMMAND:-}" ]; then
  export HARNESS_PROMPT_FILE="$prompt_file"
  export HARNESS_PROMPT="$prompt"
  exec /bin/sh -lc "$ANTIGRAVITY_RUN_COMMAND"
fi

settings_dir="$HOME/.gemini/antigravity-cli"
mkdir -p "$settings_dir"
if [ ! -f "$settings_dir/settings.json" ]; then
  cat > "$settings_dir/settings.json" <<'EOF'
{
  "permissions": {
    "allow": [
      "command(*)"
    ]
  },
  "trustedWorkspaces": [
    "/workspace"
  ]
}
EOF
fi

exec agy --add-dir /workspace --dangerously-skip-permissions -p "$prompt"
