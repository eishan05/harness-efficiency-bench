#!/bin/sh
set -eu

prompt_file="${1:-/workspace/.benchmark_prompt.txt}"

if [ -n "${OPENROUTER_API_KEY:-}" ]; then
  : "${OPENROUTER_MODEL:?OPENROUTER_MODEL is required when OPENROUTER_API_KEY is set}"
  : "${HERMES_TOOLSETS:=terminal}"
  export HERMES_YOLO_MODE=1
  if [ -n "${OPENROUTER_BASE_URL:-}" ]; then
    export HERMES_BASE_URL="$OPENROUTER_BASE_URL"
  fi
  export HERMES_PROVIDER=openrouter
  python3 - "$prompt_file" <<'PY'
import os
import sys
from pathlib import Path

from cli import main

prompt = Path(sys.argv[1]).read_text(encoding="utf-8")
main(
    query=prompt,
    provider=os.environ["HERMES_PROVIDER"],
    model=os.environ["OPENROUTER_MODEL"],
    api_key=os.environ["OPENROUTER_API_KEY"],
    base_url=os.environ.get("HERMES_BASE_URL"),
    toolsets=os.environ.get("HERMES_TOOLSETS", "terminal"),
    quiet=True,
)
PY
  exit $?
fi

if [ -z "${HERMES_RUN_COMMAND:-}" ]; then
  echo "HERMES_RUN_COMMAND is required until the Hermes one-shot benchmark path is smoke-verified." >&2
  exit 2
fi

export HARNESS_PROMPT_FILE="$prompt_file"
exec /bin/sh -lc "$HERMES_RUN_COMMAND"
