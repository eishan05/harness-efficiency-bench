#!/bin/sh
set -eu

prompt_file="${1:-/workspace/.benchmark_prompt.txt}"

# v2 provider slot: BENCH_* (set for OpenCode Go runs through the usage proxy) maps
# onto the v1 OPENROUTER_* names, which this wrapper treats as "an OpenAI-compatible
# API at OPENROUTER_BASE_URL" whenever that base URL is set.
if [ -n "${BENCH_API_KEY:-}" ]; then
  export OPENROUTER_API_KEY="$BENCH_API_KEY"
  export OPENROUTER_MODEL="${BENCH_MODEL:?BENCH_MODEL is required with BENCH_API_KEY}"
  if [ -n "${BENCH_BASE_URL:-}" ]; then export OPENROUTER_BASE_URL="$BENCH_BASE_URL"; fi
fi
mkdir -p "$HOME/.config/kilo"

if [ -n "${OPENROUTER_API_KEY:-}" ]; then
  : "${OPENROUTER_MODEL:?OPENROUTER_MODEL is required when OPENROUTER_API_KEY is set}"
  : "${KILO_MODEL:=openrouter/$OPENROUTER_MODEL}"
  : "${OPENROUTER_BASE_URL:=https://openrouter.ai/api/v1}"
  model_name="${KILO_MODEL#openrouter/}"
  mkdir -p "$HOME/.local/share/kilo"
  cat > "$HOME/.local/share/kilo/auth.json" <<EOF
{
  "openrouter": {
    "type": "api",
    "key": "${OPENROUTER_API_KEY}"
  }
}
EOF
  cat > "$HOME/.config/kilo/opencode.json" <<EOF
{
  "\$schema": "https://app.kilo.ai/config.json",
  "model": "${KILO_MODEL}",
  "provider": {
    "openrouter": {
      "env": ["OPENROUTER_API_KEY"],
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "baseURL": "${OPENROUTER_BASE_URL}"
      },
      "models": {
        "${model_name}": {}
      }
    }
  },
  "permission": ["allow"]
}
EOF
else
  : "${KILO_MODEL:=openai/gpt-4o-mini}"
  : "${OPENAI_BASE_URL:=https://api.openai.com/v1}"
  cat > "$HOME/.config/kilo/opencode.json" <<EOF
{
  "\$schema": "https://app.kilo.ai/config.json",
  "model": "${KILO_MODEL}",
  "provider": {
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}",
        "baseURL": "${OPENAI_BASE_URL}"
      }
    }
  },
  "permission": ["allow"]
}
EOF
fi

set -- kilo run \
  --format json \
  "Execute the complete benchmark instructions in the attached prompt file." \
  --file "$prompt_file"

if [ -n "${KILO_MAX_WALL_TIME:-}" ]; then
  exec timeout --kill-after=10s "$KILO_MAX_WALL_TIME" "$@"
fi
exec "$@"
