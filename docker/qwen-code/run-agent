#!/bin/sh
set -eu

prompt_file="${1:-/workspace/.benchmark_prompt.txt}"

# v2 provider slot: BENCH_* (set for OpenCode Go runs through the usage proxy) maps
# onto the v1 OPENROUTER_* names, which this wrapper treats as "an OpenAI-compatible
# API at OPENROUTER_BASE_URL" whenever that base URL is set.
if [ -n "${BENCH_API_KEY:-}" ]; then
  export OPENROUTER_API_KEY="$BENCH_API_KEY"
  export OPENROUTER_MODEL="${BENCH_MODEL:?BENCH_MODEL is required with BENCH_API_KEY}"
  if [ -n "${BENCH_BASE_URL:-}" ]; then export OPENROUTER_BASE_URL="$BENCH_BASE_URL"; fi
fi
if [ -n "${OPENROUTER_API_KEY:-}" ]; then
  : "${OPENROUTER_MODEL:?OPENROUTER_MODEL is required when OPENROUTER_API_KEY is set}"
  : "${QWEN_MODEL_NAME:=$OPENROUTER_MODEL}"
  : "${QWEN_BASE_URL:=https://openrouter.ai/api/v1}"
  : "${QWEN_API_KEY_ENV:=OPENROUTER_API_KEY}"
else
  : "${QWEN_MODEL_NAME:=qwen3-coder-plus}"
  : "${QWEN_BASE_URL:=https://dashscope.aliyuncs.com/compatible-mode/v1}"
  : "${QWEN_API_KEY_ENV:=DASHSCOPE_API_KEY}"
fi

mkdir -p "$HOME/.qwen"
cat > "$HOME/.qwen/settings.json" <<EOF
{
  "modelProviders": {
    "openai": [
      {
        "id": "${QWEN_MODEL_NAME}",
        "name": "${QWEN_MODEL_NAME}",
        "baseUrl": "${QWEN_BASE_URL}",
        "envKey": "${QWEN_API_KEY_ENV}"
      }
    ]
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "model": {
    "name": "${QWEN_MODEL_NAME}"
  }
}
EOF

set -- qwen \
  --yolo \
  --input-format text \
  --output-format stream-json

if [ -n "${QWEN_MAX_SESSION_TURNS:-}" ]; then
  set -- "$@" --max-session-turns "$QWEN_MAX_SESSION_TURNS"
fi
if [ -n "${QWEN_MAX_TOOL_CALLS:-}" ]; then
  set -- "$@" --max-tool-calls "$QWEN_MAX_TOOL_CALLS"
fi
if [ -n "${QWEN_MAX_WALL_TIME:-}" ]; then
  set -- "$@" --max-wall-time "$QWEN_MAX_WALL_TIME"
fi

"$@" < "$prompt_file"
