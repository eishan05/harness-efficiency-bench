#!/bin/sh
set -eu

prompt_file="${1:-/workspace/.benchmark_prompt.txt}"

# v2 provider slot: BENCH_* (set for OpenCode Go runs through the usage proxy) maps
# onto the v1 OPENROUTER_* names, which this wrapper treats as "an OpenAI-compatible
# API at OPENROUTER_BASE_URL" whenever that base URL is set.
if [ -n "${BENCH_API_KEY:-}" ]; then
  export OPENROUTER_API_KEY="$BENCH_API_KEY"
  export OPENROUTER_MODEL="${BENCH_MODEL:?BENCH_MODEL is required with BENCH_API_KEY}"
  if [ -n "${BENCH_BASE_URL:-}" ]; then export OPENROUTER_BASE_URL="$BENCH_BASE_URL"; fi
fi
export KIMI_CODE_HOME="${KIMI_CODE_HOME:-$HOME/.kimi-code}"
export KIMI_DISABLE_TELEMETRY="${KIMI_DISABLE_TELEMETRY:-1}"

mkdir -p "$KIMI_CODE_HOME"
if [ -n "${OPENROUTER_API_KEY:-}" ]; then
  : "${OPENROUTER_MODEL:?OPENROUTER_MODEL is required when OPENROUTER_API_KEY is set}"
  : "${KIMI_MODEL_NAME:=$OPENROUTER_MODEL}"
  : "${KIMI_BASE_URL:=https://openrouter.ai/api/v1}"
  : "${KIMI_MAX_CONTEXT_SIZE:=131072}"
  export KIMI_MODEL_NAME
  export KIMI_MODEL_API_KEY="$OPENROUTER_API_KEY"
  export KIMI_MODEL_PROVIDER_TYPE=openai
  export KIMI_MODEL_BASE_URL="$KIMI_BASE_URL"
  export KIMI_MODEL_MAX_CONTEXT_SIZE="$KIMI_MAX_CONTEXT_SIZE"
  cat > "$KIMI_CODE_HOME/config.toml" <<EOF
default_model = "${KIMI_MODEL_NAME}"

[providers.openrouter]
type = "openai"
base_url = "${KIMI_BASE_URL}"
api_key = "${OPENROUTER_API_KEY}"

[models."${KIMI_MODEL_NAME}"]
provider = "openrouter"
model = "${KIMI_MODEL_NAME}"
max_context_size = ${KIMI_MAX_CONTEXT_SIZE}
EOF
elif [ -n "${KIMI_API_KEY:-}" ]; then
  : "${KIMI_MODEL_NAME:=kimi-for-coding}"
  : "${KIMI_BASE_URL:=https://api.moonshot.ai/v1}"
  : "${KIMI_MAX_CONTEXT_SIZE:=131072}"
  export KIMI_MODEL_NAME
  export KIMI_MODEL_API_KEY="$KIMI_API_KEY"
  export KIMI_MODEL_PROVIDER_TYPE=kimi
  export KIMI_MODEL_BASE_URL="$KIMI_BASE_URL"
  export KIMI_MODEL_MAX_CONTEXT_SIZE="$KIMI_MAX_CONTEXT_SIZE"
  cat > "$KIMI_CODE_HOME/config.toml" <<EOF
[providers.kimi]
type = "kimi"
base_url = "${KIMI_BASE_URL}"
api_key = "${KIMI_API_KEY}"

[models."${KIMI_MODEL_NAME}"]
provider = "kimi"
model = "${KIMI_MODEL_NAME}"
max_context_size = ${KIMI_MAX_CONTEXT_SIZE}
EOF
else
  : "${KIMI_MODEL_NAME:=kimi-for-coding}"
  export KIMI_MODEL_NAME
fi

# Kimi Code 2.x has a headless prompt mode (-p). It refuses --auto and runs without
# approval prompts on its own; v1 also called it with neither --yolo nor --auto. The
# prompt is read from the file into one argument, as v1 passed it.
set -- kimi --output-format stream-json -m "$KIMI_MODEL_NAME" -p "$(cat "$prompt_file")"

status=0
if [ -n "${KIMI_MAX_WALL_TIME:-}" ]; then
  timeout --kill-after=10s "$KIMI_MAX_WALL_TIME" "$@" || status=$?
else
  "$@" || status=$?
fi
exit "$status"
