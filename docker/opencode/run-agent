#!/bin/sh
set -eu

prompt_file="${1:-/workspace/.benchmark_prompt.txt}"
mkdir -p "$HOME/.config/opencode"

if [ -n "${OPENROUTER_API_KEY:-}" ]; then
  : "${OPENROUTER_MODEL:?OPENROUTER_MODEL is required when OPENROUTER_API_KEY is set}"
  : "${OPENCODE_MODEL:=openrouter/$OPENROUTER_MODEL}"
  : "${OPENROUTER_BASE_URL:=https://openrouter.ai/api/v1}"
  model_name="${OPENCODE_MODEL#openrouter/}"
  mkdir -p "$HOME/.local/share/opencode"
  cat > "$HOME/.local/share/opencode/auth.json" <<EOF
{
  "openrouter": {
    "type": "api",
    "key": "${OPENROUTER_API_KEY}"
  }
}
EOF
  cat > "$HOME/.config/opencode/opencode.json" <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "model": "${OPENCODE_MODEL}",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "baseURL": "${OPENROUTER_BASE_URL}"
      },
      "models": {
        "${model_name}": {}
      }
    }
  },
  "permission": "allow"
}
EOF
else
  : "${OPENCODE_MODEL:=openai/gpt-4o-mini}"
  : "${OPENAI_BASE_URL:=https://api.openai.com/v1}"
  cat > "$HOME/.config/opencode/opencode.json" <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "model": "${OPENCODE_MODEL}",
  "provider": {
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}",
        "baseURL": "${OPENAI_BASE_URL}"
      }
    }
  },
  "permission": "allow"
}
EOF
fi

set -- opencode run \
  --format json \
  "Execute the complete benchmark instructions in the attached prompt file." \
  --file "$prompt_file"

if [ -n "${OPENCODE_MAX_WALL_TIME:-}" ]; then
  exec timeout --kill-after=10s "$OPENCODE_MAX_WALL_TIME" "$@"
fi
exec "$@"
